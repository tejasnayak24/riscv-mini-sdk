#!/usr/bin/env bash
set -Eeuo pipefail
ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$ROOT_DIR"
command=${1:-help}
profile=${BUILD:-release}
usage() { echo "usage: ./sdk {build|run|test|inspect|package|clean|help} [app]"; }
case "$command" in
  build) [[ $# -eq 2 ]] || { usage >&2; exit 2; }; make "build/$profile/bin/$2" ;;
  run) [[ $# -eq 2 ]] || { usage >&2; exit 2; }; make BUILD="$profile" run APP="$2" ;;
  inspect) [[ $# -eq 2 ]] || { usage >&2; exit 2; }; make BUILD="$profile" inspect APP="$2" ;;
  test|clean|package|help) make BUILD="$profile" "$command" ;;
  *) echo "unknown command: $command" >&2; usage >&2; exit 2 ;;
esac
